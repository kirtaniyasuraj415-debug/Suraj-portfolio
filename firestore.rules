rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // 1. Global Default Deny Catch-All
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function hasVerifiedEmail() {
      return isSignedIn()
        && request.auth.token.email is string
        && request.auth.token.email_verified == true;
    }

    function isOwner() {
      return hasVerifiedEmail()
        && request.auth.token.email == 'surajkirtaniya5@gmail.com';
    }

    function isAdmin() {
      return isOwner()
        || (
          hasVerifiedEmail()
          && exists(/databases/$(database)/documents/adminEmails/$(request.auth.token.email))
        );
    }

    function isValidProjectEnquiry(data) {
      return data.keys().hasAll(['name', 'phone', 'projectType', 'budget']) &&
        data.keys().hasOnly([
          'name', 'businessName', 'phone', 'preferredContactMethod',
          'businessType', 'projectType', 'currentWebsite', 'budget',
          'timeline', 'projectGoal', 'reference', 'preferredContactTime',
          'whatsappNumber', 'whatsappLink', 'source', 'status',
          'telegramNotificationStatus', 'createdAt'
        ]) &&
        data.name is string && data.name.size() >= 2 && data.name.size() <= 100 &&
        data.phone is string && data.phone.size() >= 7 && data.phone.size() <= 32 &&
        data.projectType is string && data.projectType.size() <= 100 &&
        data.budget is string && data.budget.size() <= 100 &&
        (!('businessName' in data) || (data.businessName is string && data.businessName.size() <= 120)) &&
        (!('preferredContactMethod' in data) || data.preferredContactMethod in ['whatsapp', 'phone']) &&
        (!('businessType' in data) || (data.businessType is string && data.businessType.size() <= 100)) &&
        (!('currentWebsite' in data) || (data.currentWebsite is string && data.currentWebsite.size() <= 240)) &&
        (!('timeline' in data) || (data.timeline is string && data.timeline.size() <= 100)) &&
        (!('projectGoal' in data) || (data.projectGoal is string && data.projectGoal.size() <= 2500)) &&
        (!('reference' in data) || (data.reference is string && data.reference.size() <= 240)) &&
        (!('preferredContactTime' in data) || data.preferredContactTime in ['', 'morning', 'afternoon', 'evening', 'anytime']) &&
        (!('whatsappNumber' in data) || (data.whatsappNumber is string && data.whatsappNumber.size() <= 32)) &&
        (!('whatsappLink' in data) || (data.whatsappLink is string && data.whatsappLink.size() <= 200)) &&
        (!('source' in data) || (data.source is string && data.source.size() <= 100)) &&
        (!('status' in data) || data.status in ['new', 'contacted', 'qualified', 'in-progress', 'closed']) &&
        (!('telegramNotificationStatus' in data) || data.telegramNotificationStatus in ['pending', 'sent', 'unconfirmed']) &&
        (!('createdAt' in data) || (data.createdAt is string && data.createdAt.size() <= 50));
    }

    // Email allowlist for the admin panel. The owner email above is always
    // authorized, so first login needs no manual UID or Firestore bootstrap.
    match /adminEmails/{email} {
      // A signed-in user may only check whether their own verified email is allowed.
      allow get: if hasVerifiedEmail() && request.auth.token.email == email;

      // Only the owner can view the full admin list or add/remove admins.
      allow list, create, update, delete: if isOwner();
    }

    // Legacy UID records remain readable for the owner only. New access control
    // uses adminEmails and does not require UID setup.
    match /admins/{adminId} {
      allow read, write: if isOwner();
    }

    // Client project enquiries collection (PII Protected)
    match /projectEnquiries/{enquiryId} {
      // PII Protection: Only authenticated administrators can read or list client enquiries
      allow get, list: if isAdmin();

      // Creation allows incoming leads conforming to strict validation schema
      allow create: if isValidId(enquiryId) && isValidProjectEnquiry(incoming());

      // Updates restricted to administrators (pipeline state updates, archiving)
      allow update: if isValidId(enquiryId) &&
        isAdmin() &&
        isValidProjectEnquiry(incoming()) &&
        (!('createdAt' in existing()) || incoming().createdAt == existing().createdAt);

      allow delete: if isValidId(enquiryId) && isAdmin();
    }



    // Public portfolio CMS. Visitors can only read visible content;
    // authenticated administrators can manage everything.
    match /portfolioProjects/{projectId} {
      allow get, list: if isAdmin() || resource.data.visible == true;
      allow create, update, delete: if isAdmin();
    }

    match /portfolioServices/{serviceId} {
      allow get, list: if isAdmin() || resource.data.visible == true;
      allow create, update, delete: if isAdmin();
    }

    match /portfolioSettings/{settingsId} {
      allow get: if settingsId == "public" || isAdmin();
      allow list: if isAdmin();
      allow create, update, delete: if isAdmin();
    }

    // Reserved for the admin-panel review migration. Public can read only
    // explicitly published reviews; admins can moderate them.
    match /portfolioReviews/{reviewId} {
      allow get, list: if isAdmin() || resource.data.status == "approved";
      allow create, update, delete: if isAdmin();
    }

    // Connection testing heartbeat document (read-only probe)
    match /test/{testId} {
      allow get: if isValidId(testId);
      allow list, write: if false;
    }
  }
}
