# Server environment only. Never prefix these with NEXT_PUBLIC_.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Compatibility alias accepted by the unified Node server if TELEGRAM_CHAT_ID is not set.
# TELEGRAM_OWNER_CHAT_ID=

# Optional Firestore persistence. Configure one authentication method for the legacy Next API fallback:
# 1. Secret containing a Firebase service-account JSON object (non-Google hosts).
FIREBASE_SERVICE_ACCOUNT_JSON=
# 2. Application Default Credentials (Cloud Run also detects K_SERVICE).
# FIREBASE_USE_ADC=true
# GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/server-credentials.json
