{
  "entities": {
    "projectEnquiry": {
      "title": "Project Enquiry",
      "description": "Client enquiry submitted from the portfolio website",
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 2,
          "maxLength": 100,
          "description": "Client full name"
        },
        "businessName": {
          "type": "string",
          "maxLength": 120,
          "description": "Business or company name"
        },
        "phone": {
          "type": "string",
          "minLength": 7,
          "maxLength": 32,
          "description": "Client phone number with country code"
        },
        "preferredContactMethod": {
          "type": "string",
          "enum": ["whatsapp", "phone"],
          "description": "Preferred communication channel"
        },
        "businessType": {
          "type": "string",
          "maxLength": 100,
          "description": "Industry or business category"
        },
        "projectType": {
          "type": "string",
          "maxLength": 100,
          "description": "Type of web service or project requested"
        },
        "currentWebsite": {
          "type": "string",
          "maxLength": 240,
          "description": "Existing website URL"
        },
        "budget": {
          "type": "string",
          "maxLength": 100,
          "description": "Budget tier selected"
        },
        "timeline": {
          "type": "string",
          "maxLength": 100,
          "description": "Expected delivery timeline"
        },
        "projectGoal": {
          "type": "string",
          "maxLength": 2500,
          "description": "Project goals, requirements and scope details"
        },
        "reference": {
          "type": "string",
          "maxLength": 240,
          "description": "Design references or inspiration links"
        },
        "preferredContactTime": {
          "type": "string",
          "enum": ["", "morning", "afternoon", "evening", "anytime"],
          "description": "Best time window to contact"
        },
        "whatsappNumber": {
          "type": "string",
          "maxLength": 32,
          "description": "Clean digits for WhatsApp messaging"
        },
        "whatsappLink": {
          "type": "string",
          "maxLength": 200,
          "description": "Direct WhatsApp chat link"
        },
        "source": {
          "type": "string",
          "maxLength": 100,
          "description": "Origin of enquiry submission"
        },
        "status": {
          "type": "string",
          "enum": ["new", "contacted", "qualified", "in-progress", "closed"],
          "description": "Pipeline status of the enquiry"
        },
        "telegramNotificationStatus": {
          "type": "string",
          "enum": ["pending", "sent", "unconfirmed"],
          "description": "Telegram notification delivery status"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Timestamp when enquiry was received"
        }
      },
      "required": ["name", "phone", "projectType", "budget"]
    },
    "testConnection": {
      "title": "Connection Test",
      "description": "Heartbeat probe to verify Firestore connectivity",
      "type": "object",
      "properties": {
        "status": {
          "type": "string",
          "description": "Connection test probe status"
        },
        "timestamp": {
          "type": "string",
          "format": "date-time",
          "description": "Probe check timestamp"
        }
      },
      "required": ["status"]
    }
  },
  "firestore": {
    "/projectEnquiries/{enquiryId}": {
      "schema": "projectEnquiry",
      "description": "Collection of incoming project enquiries from prospective clients"
    },
    "/test/{testId}": {
      "schema": "testConnection",
      "description": "Heartbeat documents for connectivity testing"
    }
  }
}
